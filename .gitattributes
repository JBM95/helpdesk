# SOLVO:BEGIN
# Solvo hashes these files byte for byte. Without eol=lf a Windows checkout converts them
# to CRLF and every one of them reads as drifted. Do not remove.
/.agents/** eol=lf
/.claude/commands/** eol=lf
/.claude/skills/** eol=lf
/.claude/agents/** eol=lf
/.claude/settings.json eol=lf
/.solvo/**/*.json eol=lf
/.gitattributes eol=lf
/.mcp.json eol=lf
/solvo.json eol=lf
/solvo.lock.json eol=lf
/solvo.manifest.json eol=lf
# SOLVO:END

# The generated block above covers /.solvo/**/*.json, but the markdown records beside it are
# hashed too — `solvo qa-scope` hashes test plans and case sets byte for byte, and the evidence
# pack digests the recon log and story spec. With core.autocrlf=true a Windows checkout rewrites
# them to CRLF and every recorded approval reads as drifted.
#
# Scoped to *.md rather than ** so a future binary under .solvo/ is not corrupted by an eol filter.
/.solvo/**/*.md eol=lf
